# ---------- Database ----------
DB_USER=user
DB_PASSWORD=change-me-strong-password
DB_NAME=image_voting
# Used by the app container (Compose overrides host to "postgres").
# Local non-Docker dev:
DATABASE_URL=postgresql://user:change-me-strong-password@localhost:5432/image_voting

# ---------- Web ----------
WEB_PORT=8088
# Public URL behind reverse proxy, e.g. https://voting.example.com
NEXTAUTH_URL=http://localhost:8088
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# ---------- Keycloak ----------
KEYCLOAK_CLIENT_ID=nextjs-app
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/image-voting

# ---------- File storage ----------
# Inside Docker this is /app/uploads (set by docker-compose.yml).
UPLOAD_DIR=./uploads
